+void paging_manager::load_pins() {
+    const std::string & path = params.pin_file;
+    if (path.empty()) {
+        return;
+    }
+    std::ifstream file(path);
+    if (!file.is_open()) {
+        throw std::runtime_error(std::string("cannot open MoE pin file: ") + path);
+    }
+    int32_t applied = 0;
+    int32_t skipped = 0;
+    std::string line;
+    while (std::getline(file, line)) {
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+        int32_t layer = -1;
+        const char * sep = std::strchr(line.c_str(), ':');
+        if (!sep || std::sscanf(line.c_str(), "%d", &layer) != 1) {
+            continue;
+        }
+        if (!index.has_layer(layer)) {
+            ++skipped;
+            continue;
+        }
+        std::string experts_str(sep + 1);
+        std::replace(experts_str.begin(), experts_str.end(), ',', ' ');
+        std::istringstream experts(experts_str);
+        int32_t expert = 0;
+        auto & layer_pins = pins[layer];
+        while (experts >> expert) {
+            if (expert < 0 || expert >= index.expert_count(layer)) {
+                ++skipped;
+                continue;
+            }
+            layer_pins.push_back(expert);
+            ++applied;
+        }
+    }
+    LLAMA_LOG_INFO("MoE paging: loaded %d pinned experts from %s (%d skipped)\n",
+                   applied, path.c_str(), skipped);
+}
